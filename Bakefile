bake_task deploy-traefik "Deploy Traefik Ingress with Cloudflare DNS-01 challenge"
function deploy-traefik () {
    bake_echo_blue "=== Deploying Traefik Ingress ==="

    # Ensure dependencies are installed
    install || return 1

    # Check for required environment variables
    if [ -z "${CF_DNS_API_TOKEN:-}" ]; then
        bake_echo_red "✗ Error: CF_DNS_API_TOKEN environment variable is not set."
        bake_echo_yellow "Please export your Cloudflare API Token (Zone.DNS.Edit permission):"
        bake_echo_yellow "  export CF_DNS_API_TOKEN=\"your-token\""
        return 1
    fi

    if [ -z "${CF_ACME_EMAIL:-}" ]; then
        bake_echo_red "✗ Error: CF_ACME_EMAIL environment variable is not set."
        bake_echo_yellow "Please export your Let's Encrypt / Cloudflare email address:"
        bake_echo_yellow "  export CF_ACME_EMAIL=\"your-email@example.com\""
        return 1
    fi

    # 1. Add repo and update
    helm repo add traefik https://traefik.github.io/charts
    helm repo update

    # 2. Create Namespace if it doesn't exist
    kubectl create namespace traefik --dry-run=client -o yaml | kubectl apply -f -

    # 3. Deploy the Cloudflare credentials secret
    bake_echo_cyan "Creating Cloudflare credentials secret..."
    kubectl create secret generic cloudflare-credentials \
      --namespace traefik \
      --from-literal=CF_DNS_API_TOKEN="$CF_DNS_API_TOKEN" \
      --from-literal=CF_ACME_EMAIL="$CF_ACME_EMAIL" \
      --dry-run=client -o yaml | kubectl apply -f -

    # 4. Deploy Traefik via Helm
    bake_echo_cyan "Deploying Traefik Helm release..."
    helm upgrade --install traefik traefik/traefik \
      --namespace traefik \
      --values "$(bake_bakefile_dir)/traefik/values.yaml"

    # 5. Apply the TLSStore configuration for the default wildcard certificate
    bake_echo_cyan "Applying default TLSStore wildcard certificate configuration..."
    kubectl apply -f "$(bake_bakefile_dir)/traefik/tls-store.yaml"

    bake_echo_green "✓ Traefik deployed and TLSStore configured successfully!"
}

bake_task deploy-vault "Deploy HashiCorp Vault via ArgoCD and configure OIDC authentication"
function deploy-vault () {
    bake_echo_blue "=== Deploying HashiCorp Vault via ArgoCD ==="

    # Ensure dependencies are installed
    install || return 1

    # 1. Create namespaces if they don't exist
    kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
    kubectl create namespace vault --dry-run=client -o yaml | kubectl apply -f -

    # 2. Check if Vault OAuth credentials secret exists in argocd namespace
    local secret_exists=0
    if kubectl get secret vault-oauth -n argocd &>/dev/null; then
        secret_exists=1
    fi

    if [ "$secret_exists" -eq 0 ]; then
        bake_echo_cyan "Generating new Vault OAuth client secret..."
        local vault_client_secret
        vault_client_secret=$(openssl rand -hex 20)

        # Create vault-oauth secret in argocd namespace
        kubectl create secret generic vault-oauth \
          --namespace argocd \
          --from-literal=client-secret="$vault_client_secret" \
          --dry-run=client -o yaml | kubectl apply -f -
        kubectl label secret vault-oauth app.kubernetes.io/part-of=argocd -n argocd --overwrite

        # Create vault-oauth secret in vault namespace for reference
        kubectl create secret generic vault-oauth \
          --namespace vault \
          --from-literal=client-secret="$vault_client_secret" \
          --dry-run=client -o yaml | kubectl apply -f -
        kubectl label secret vault-oauth app.kubernetes.io/part-of=vault -n vault --overwrite
    else
        bake_echo_blue "i Using existing Vault OAuth client secret from secret 'vault-oauth'"
    fi

    # 3. Apply ArgoCD values and restart Dex server to pick up static client
    bake_echo_cyan "Applying Dex configuration changes to ArgoCD..."
    deploy-argocd || return 1

    # 4. Apply the Vault ArgoCD Application manifest
    bake_echo_cyan "Applying Vault ArgoCD Application..."
    kubectl apply -f "$(bake_bakefile_dir)/argocd/apps/vault.yaml"

    # If we are on a feature branch, patch ArgoCD Application to track this branch
    local current_branch
    current_branch=$(git -C "$(bake_bakefile_dir)" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
    if [ "$current_branch" != "main" ] && [ -n "$current_branch" ]; then
        bake_echo_cyan "Local branch is '$current_branch'. Patching ArgoCD Application to track this branch..."
        kubectl patch application vault -n argocd --type='json' -p="[{\"op\": \"replace\", \"path\": \"/spec/source/targetRevision\", \"value\": \"$current_branch\"}]"
    fi

    # 5. Wait for the vault-0 pod to start and become ready
    bake_echo_cyan "Waiting for Vault pod vault-0 to be ready..."
    local pod_exists=0
    for i in {1..30}; do
        if kubectl get pod vault-0 -n vault &>/dev/null; then
            pod_exists=1
            break
        fi
        sleep 2
    done
    if [ "$pod_exists" -eq 0 ]; then
        bake_echo_red "✗ Error: vault-0 pod did not start in time."
        return 1
    fi

    # Wait for the pod phase to be Running
    kubectl wait --namespace vault --for=jsonpath='{.status.phase}'=Running pod/vault-0 --timeout=90s || return 1
    # Give Vault server a brief moment to fully initialize the listener
    sleep 5

    # 6. Initialize Vault if not already initialized
    local status_json
    status_json=$(kubectl exec -n vault vault-0 -- vault status -format=json 2>/dev/null || true)

    local init_status="false"
    if [ -n "$status_json" ]; then
        init_status=$(echo "$status_json" | jq -r '.initialized' 2>/dev/null || echo "false")
    fi

    if [ "$init_status" = "false" ]; then
        bake_echo_cyan "Initializing Vault (1 key share, 1 key threshold)..."
        local init_output
        init_output=$(kubectl exec -n vault vault-0 -- vault operator init -key-shares=1 -key-threshold=1 -format=json)

        local root_token
        root_token=$(echo "$init_output" | jq -r '.root_token' | tr -d '\r')
        local unseal_key
        unseal_key=$(echo "$init_output" | jq -r '.unseal_keys_b64[0]' | tr -d '\r')

        bake_echo_green "✓ Vault initialized successfully!"
        bake_echo_yellow "===================================================="
        bake_echo_yellow "Vault Root Token: $root_token"
        bake_echo_yellow "Vault Unseal Key: $unseal_key"
        bake_echo_yellow "===================================================="

        # Save keys locally to .vault-keys
        echo "ROOT_TOKEN=$root_token" > "$(bake_bakefile_dir)/.vault-keys"
        echo "UNSEAL_KEY=$unseal_key" >> "$(bake_bakefile_dir)/.vault-keys"
        chmod 600 "$(bake_bakefile_dir)/.vault-keys"

        # Ensure .vault-keys is in gitignore
        if ! grep -q "\.vault-keys" "$(bake_bakefile_dir)/.gitignore"; then
            echo ".vault-keys" >> "$(bake_bakefile_dir)/.gitignore"
        fi
    else
        bake_echo_blue "i Vault is already initialized."
    fi

    # 7. Unseal Vault if sealed
    status_json=$(kubectl exec -n vault vault-0 -- vault status -format=json 2>/dev/null || true)
    local sealed_status="true"
    if [ -n "$status_json" ]; then
        sealed_status=$(echo "$status_json" | jq -r '.sealed' 2>/dev/null || echo "true")
    fi
    if [ "$sealed_status" = "true" ]; then
        if [ -f "$(bake_bakefile_dir)/.vault-keys" ]; then
            bake_echo_cyan "Unsealing Vault using stored keys..."
            local unseal_key
            unseal_key=$(grep "UNSEAL_KEY" "$(bake_bakefile_dir)/.vault-keys" | cut -d'=' -f2 | tr -d '\r')
            kubectl exec -n vault vault-0 -- vault operator unseal "$unseal_key"
        else
            bake_echo_yellow "⚠ Vault is sealed and no stored keys were found at .vault-keys."
            bake_echo_yellow "Please unseal Vault manually by running:"
            bake_echo_yellow "  kubectl exec -it -n vault vault-0 -- vault operator unseal"
            return 1
        fi
    else
        bake_echo_blue "i Vault is already unsealed."
    fi

    # 8. Configure Vault Policies and OIDC
    local root_token
    if [ -f "$(bake_bakefile_dir)/.vault-keys" ]; then
        root_token=$(grep "ROOT_TOKEN" "$(bake_bakefile_dir)/.vault-keys" | cut -d'=' -f2 | tr -d '\r')
    else
        echo -n "Please enter your Vault Root Token to configure auth: "
        read -s -r root_token
        echo ""
    fi

    local client_secret
    client_secret=$(kubectl get secret vault-oauth -n argocd -o jsonpath='{.data.client-secret}' | base64 --decode | tr -d '\r')

    bake_echo_cyan "Configuring Vault admin policy..."
    kubectl exec -i -n vault vault-0 -- sh -c "VAULT_TOKEN=$root_token vault policy write admin - <<EOF
path \"*\" {
  capabilities = [\"create\", \"read\", \"update\", \"delete\", \"list\", \"sudo\"]
}
EOF"

    bake_echo_cyan "Enabling Vault OIDC auth method..."
    kubectl exec -n vault vault-0 -- sh -c "VAULT_TOKEN=$root_token vault auth enable oidc" 2>/dev/null || true

    bake_echo_cyan "Configuring OIDC provider with Dex URL..."
    kubectl exec -n vault vault-0 -- sh -c "VAULT_TOKEN=$root_token vault write auth/oidc/config \
        oidc_discovery_url=\"https://argocd.noeg.ai/api/dex\" \
        oidc_client_id=\"vault\" \
        oidc_client_secret=\"$client_secret\" \
        default_role=\"admin\""

    bake_echo_cyan "Configuring Vault admin OIDC role..."
    kubectl exec -i -n vault vault-0 -- sh -c "VAULT_TOKEN=$root_token vault write auth/oidc/role/admin -" <<EOF
{
  "allowed_redirect_uris": [
    "https://vault.noeg.ai/ui/vault/auth/oidc/oidc/callback",
    "http://localhost:8250/oidc/callback"
  ],
  "user_claim": "preferred_username",
  "policies": ["admin"],
  "bound_claims": {
    "preferred_username": ["nagonzalez"]
  }
}
EOF

    bake_echo_green "✓ HashiCorp Vault deployed and OIDC configured successfully!"
    bake_echo_blue "Access your Vault UI at: https://vault.noeg.ai"
    bake_echo_yellow "Note: OIDC login is enabled and restricted strictly to user 'nagonzalez'."
}

bake_task install "Detect OS and install homelab dependencies (starting with OrbStack)"
function install () {
    bake_echo_blue "=== Starting Homelab Dependency Installation ==="

    # 1. Detect OS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        bake_echo_green "✓ macOS detected"

        # 2. Check for Homebrew
        if ! command -v brew &>/dev/null; then
            bake_echo_red "✗ Homebrew is not installed. Please install it first from: https://brew.sh"
            return 1
        fi

        # 3. Install OrbStack (Cask)
        if [ -d "/Applications/OrbStack.app" ]; then
            bake_echo_blue "i OrbStack is already installed at /Applications/OrbStack.app"
        else
            bake_echo_cyan "Installing OrbStack via Homebrew Cask..."
            brew install --cask orbstack
        fi

        # Configure OrbStack settings
        setup-orbstack

        # 4. Install kubectl (required for k8s management)
        if command -v kubectl &>/dev/null && kubectl version --client 2>/dev/null | grep -q "v1.33"; then
            bake_echo_blue "i kubectl (v1.33) is already installed"
        else
            bake_echo_cyan "Installing kubectl@1.33 via Homebrew..."
            brew install kubernetes-cli@1.33
            brew link --overwrite --force kubernetes-cli@1.33
        fi

        # 5. Install helm (required for Kubernetes deployments)
        if command -v helm &>/dev/null; then
            bake_echo_blue "i helm is already installed"
        else
            bake_echo_cyan "Installing helm via Homebrew..."
            brew install helm
        fi

        # 6. Install gh (GitHub CLI, required for GitHub automation)
        if command -v gh &>/dev/null; then
            bake_echo_blue "i gh (GitHub CLI) is already installed"
        else
            bake_echo_cyan "Installing gh via Homebrew..."
            brew install gh
        fi

        # 7. Install argocd CLI (required for verification and cluster management)
        if command -v argocd &>/dev/null; then
            bake_echo_blue "i argocd CLI is already installed"
        else
            bake_echo_cyan "Installing argocd CLI via Homebrew..."
            brew install argocd
        fi

        # 8. Install uv (required for Python/Ansible management)
        if command -v uv &>/dev/null; then
            bake_echo_blue "i uv is already installed"
        else
            bake_echo_cyan "Installing uv via Homebrew..."
            brew install uv
        fi

        # 9. Install jq (required for JSON processing in deployment tasks)
        if command -v jq &>/dev/null; then
            bake_echo_blue "i jq is already installed"
        else
            bake_echo_cyan "Installing jq via Homebrew..."
            brew install jq
        fi

        bake_echo_green "✓ All macOS dependencies checked and installed!"
    else
        bake_echo_red "✗ This installer currently only supports macOS (Darwin)."
        return 1
    fi
}

bake_task setup-ansible "Bootstrap the Ansible environment using uv"
function setup-ansible () {
    bake_echo_blue "=== Setting Up Ansible Environment ==="

    # Ensure dependencies (like uv) are installed
    install || return 1

    bake_echo_cyan "Syncing Python virtual environment via uv..."
    uv sync || return 1

    bake_echo_green "✓ Ansible environment bootstrapped successfully!"
    bake_echo_blue "To use Ansible, activate the virtual environment:"
    bake_echo_blue "  source .venv/bin/activate"
}

bake_task setup-orbstack "Configure OrbStack settings from checked-in configuration"
function setup-orbstack () {
    bake_echo_blue "=== Configuring OrbStack ==="

    local config_file="$(bake_bakefile_dir)/orbstack/vmconfig.json"
    if [ ! -f "$config_file" ]; then
        bake_echo_red "✗ OrbStack configuration file not found at $config_file"
        return 1
    fi

    bake_echo_cyan "Applying OrbStack settings from $config_file..."
    
    # Create ~/.orbstack directory if it doesn't exist
    mkdir -p "$HOME/.orbstack"

    # Copy the config file to ~/.orbstack/vmconfig.json
    cp "$config_file" "$HOME/.orbstack/vmconfig.json"

    bake_echo_green "✓ OrbStack configuration applied successfully!"
    bake_echo_yellow "⚠  Please restart OrbStack ('orb stop' then start it) to apply any changes."
}

bake_task setup-ssh "Generate a secure Ed25519 SSH key for GitHub"
function setup-ssh () {
    local key_file="$HOME/.ssh/id_ed25519"

    bake_echo_blue "=== Setting Up GitHub SSH Key ==="

    if [ -f "$key_file" ]; then
        bake_echo_yellow "i SSH key already exists at $key_file"
    else
        # Try to get git email, fallback to whoami@hostname
        local email
        email=$(git config --global user.email 2>/dev/null || echo "$(whoami)@$(hostname)")

        bake_echo_cyan "Generating Ed25519 SSH key pair with comment: $email..."
        mkdir -p "$HOME/.ssh"
        chmod 700 "$HOME/.ssh"

        # Generate the key (will prompt for passphrase if you want one)
        ssh-keygen -t ed25519 -C "$email" -f "$key_file"
    fi

    # Start ssh-agent and add key
    bake_echo_cyan "Adding key to ssh-agent..."
    eval "$(ssh-agent -s)"

    # Configure SSH config to automatically load keys and store passphrases in Keychain (macOS standard)
    local ssh_config="$HOME/.ssh/config"
    if [ ! -f "$ssh_config" ] || ! grep -q "UseKeychain" "$ssh_config"; then
        bake_echo_cyan "Configuring $ssh_config for macOS Keychain integration..."
        cat >> "$ssh_config" <<EOF

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile $key_file
EOF
        chmod 600 "$ssh_config"
    fi

    ssh-add --apple-use-keychain "$key_file"

    bake_echo_green "✓ SSH key configuration completed!"
    bake_echo_blue "=== Copy the public key below and add it to GitHub (https://github.com/settings/keys) ==="
    cat "${key_file}.pub"
    bake_echo_blue "=================================================================================="
}

bake_task build-sequoia-iso "Download macOS Sequoia installer and build a bootable ISO"
function build-sequoia-iso () {
    bake_echo_blue "=== Building macOS Sequoia ISO ==="
    # Call the helper script
    "$(bake_bakefile_dir)/vm/build_sequoia_iso.sh"
}

bake_task build-sequoia-vm "Use Packer to create a macOS Sequoia VM in VMware Fusion"
function build-sequoia-vm () {
    bake_echo_blue "=== Building macOS Sequoia VM ==="
    
    # Check if VM is already built (Idempotency)
    local vm_output_dir="$(bake_bakefile_dir)/vm/output-macos"
    if [ -d "$vm_output_dir" ]; then
        bake_echo_green "✓ VMware VM output directory already exists at $vm_output_dir. Nothing to do."
        return 0
    fi
    
    # Check if packer is installed
    if ! command -v packer &>/dev/null; then
        bake_echo_yellow "Packer not found on the host. Installing via Homebrew..."
        brew tap hashicorp/tap
        brew install hashicorp/tap/packer
    fi

    # Ensure the ISO exists before starting the packer build
    local iso_file="$(bake_bakefile_dir)/vm/iso/Sequoia.iso"
    if [ ! -f "$iso_file" ]; then
        bake_echo_red "✗ Error: macOS Sequoia ISO not found at $iso_file."
        bake_echo_yellow "Please run 'bake build-sequoia-iso' first."
        return 1
    fi

    bake_echo_cyan "Starting Packer build (vmware-iso)..."
    
    # Save current directory, move to vm/ and build, then return
    local current_dir=$(pwd)
    cd "$(bake_bakefile_dir)/vm"
    
    # Run packer init and build
    packer init sequoia.pkr.hcl
    packer build sequoia.pkr.hcl
    
    cd "$current_dir"
}


bake_task create-orb-machine "Create a new OrbStack Linux VM with optional configurations"
function create-orb-machine () {
    # Ensure orb CLI is installed
    if ! command -v orb &>/dev/null; then
        bake_echo_red "✗ Error: OrbStack CLI ('orb') is not installed or not in PATH."
        bake_echo_yellow "You can install it using: brew install --cask orbstack"
        return 1
    fi

    local vm_name=""
    local vm_os="ubuntu:24.04"
    local vm_cpu=""
    local vm_memory=""
    local vm_cloud_init=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --name requires a value."
                    return 1
                fi
                vm_name="$2"
                shift 2
                ;;
            --os)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --os requires a value."
                    return 1
                fi
                vm_os="$2"
                shift 2
                ;;
            --cpu)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --cpu requires a value."
                    return 1
                fi
                vm_cpu="$2"
                shift 2
                ;;
            --memory)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --memory requires a value."
                    return 1
                fi
                vm_memory="$2"
                shift 2
                ;;
            --cloud-init)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --cloud-init requires a value."
                    return 1
                fi
                vm_cloud_init="$2"
                shift 2
                ;;
            -h|--help)
                echo "Usage: bake create-orb-machine <name> [options]"
                echo "   or: bake create-orb-machine --name <name> [options]"
                echo ""
                echo "Options:"
                echo "  --name <name>          Name of the VM (required)"
                echo "  --os <os>              OS distribution (default: ubuntu:24.04)"
                echo "  --cpu <cpu>            Number of CPUs (default: no limit)"
                echo "  --memory <memory>      Memory limit, e.g. 4G (default: no limit)"
                echo "  --cloud-init <file>    Path to cloud-init configuration file"
                return 0
                ;;
            -*)
                bake_echo_red "✗ Error: Unknown option $1"
                return 1
                ;;
            *)
                if [ -z "$vm_name" ]; then
                    vm_name="$1"
                    shift
                else
                    bake_echo_red "✗ Error: Multiple positional names specified ($vm_name and $1)"
                    return 1
                fi
                ;;
        esac
    done

    if [ -z "$vm_name" ]; then
        bake_echo_red "✗ Error: VM name is required."
        echo "Usage: bake create-orb-machine <name> [options]"
        return 1
    fi

    bake_echo_blue "=== Creating OrbStack VM: $vm_name ==="
    bake_echo_cyan "OS:         $vm_os"
    [ -n "$vm_cpu" ] && bake_echo_cyan "CPUs:       $vm_cpu" || bake_echo_cyan "CPUs:       No limit"
    [ -n "$vm_memory" ] && bake_echo_cyan "Memory:     $vm_memory" || bake_echo_cyan "Memory:     No limit"
    [ -n "$vm_cloud_init" ] && bake_echo_cyan "Cloud-init: $vm_cloud_init" || bake_echo_cyan "Cloud-init: None"

    # Build the orb command
    local cmd=("orb" "create")
    if [ -n "$vm_cpu" ]; then
        cmd+=("--cpus" "$vm_cpu")
    fi
    if [ -n "$vm_memory" ]; then
        cmd+=("--memory" "$vm_memory")
    fi
    if [ -n "$vm_cloud_init" ]; then
        if [ ! -f "$vm_cloud_init" ]; then
            bake_echo_red "✗ Error: Cloud-init file not found at $vm_cloud_init"
            return 1
        fi
        cmd+=("--user-data" "$vm_cloud_init")
    fi
    cmd+=("$vm_os" "$vm_name")

    # Run command
    bake_echo_cyan "Running: ${cmd[*]}"
    "${cmd[@]}"
    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
        bake_echo_green "✓ VM $vm_name created successfully!"
    else
        bake_echo_red "✗ Failed to create VM $vm_name (exit code: $exit_code)"
    fi
    return $exit_code
}

bake_task delete-orb-machine "Delete an OrbStack Linux VM"
function delete-orb-machine () {
    # Ensure orb CLI is installed
    if ! command -v orb &>/dev/null; then
        bake_echo_red "✗ Error: OrbStack CLI ('orb') is not installed or not in PATH."
        return 1
    fi

    local vm_name=""
    local force_delete=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --name)
                if [ -z "$2" ]; then
                    bake_echo_red "✗ Error: --name requires a value."
                    return 1
                fi
                vm_name="$2"
                shift 2
                ;;
            -f|--force)
                force_delete=1
                shift
                ;;
            -h|--help)
                echo "Usage: bake delete-orb-machine <name> [options]"
                echo "   or: bake delete-orb-machine --name <name> [options]"
                echo ""
                echo "Options:"
                echo "  --name <name>          Name of the VM (required)"
                echo "  -f, --force            Force deletion without confirmation"
                return 0
                ;;
            -*)
                bake_echo_red "✗ Error: Unknown option $1"
                return 1
                ;;
            *)
                if [ -z "$vm_name" ]; then
                    vm_name="$1"
                    shift
                else
                    bake_echo_red "✗ Error: Multiple positional names specified ($vm_name and $1)"
                    return 1
                fi
                ;;
        esac
    done

    if [ -z "$vm_name" ]; then
        bake_echo_red "✗ Error: VM name is required."
        echo "Usage: bake delete-orb-machine <name> [options]"
        return 1
    fi

    # Build the orb command
    local cmd=("orb" "delete")
    if [ $force_delete -eq 1 ]; then
        cmd+=("-f")
    fi
    cmd+=("$vm_name")

    # Run command
    bake_echo_blue "=== Deleting OrbStack VM: $vm_name ==="
    bake_echo_cyan "Running: ${cmd[*]}"
    "${cmd[@]}"
    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
        bake_echo_green "✓ VM $vm_name deleted successfully!"
    else
        bake_echo_red "✗ Failed to delete VM $vm_name (exit code: $exit_code)"
    fi
    return $exit_code
}
