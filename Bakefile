bake_task install "Detect OS and install homelab dependencies (starting with OrbStack)"
function install () {
    bake_echo_blue "=== Starting Homelab Dependency Installation ==="

    # 1. Detect OS
    if [[ "$OSTYPE" == "darwin"* ]]; then
        bake_echo_green "✓ macOS detected"

        # 2. Check for Homebrew
        if ! command -v brew &>/dev/null; then
            bake_echo_red "✗ Homebrew is not installed. Please install it first from: https://brew.sh"
            return 1
        fi

        # 3. Install OrbStack (Cask)
        if [ -d "/Applications/OrbStack.app" ]; then
            bake_echo_blue "i OrbStack is already installed at /Applications/OrbStack.app"
        else
            bake_echo_cyan "Installing OrbStack via Homebrew Cask..."
            brew install --cask orbstack
        fi

        # 4. Install kubectl (required for k8s management)
        if command -v kubectl &>/dev/null && kubectl version --client 2>/dev/null | grep -q "v1.33"; then
            bake_echo_blue "i kubectl (v1.33) is already installed"
        else
            bake_echo_cyan "Installing kubectl@1.33 via Homebrew..."
            brew install kubernetes-cli@1.33
            brew link --overwrite --force kubernetes-cli@1.33
        fi

        # 5. Install helm (required for Kubernetes deployments)
        if command -v helm &>/dev/null; then
            bake_echo_blue "i helm is already installed"
        else
            bake_echo_cyan "Installing helm via Homebrew..."
            brew install helm
        fi

        # 6. Install gh (GitHub CLI, required for GitHub automation)
        if command -v gh &>/dev/null; then
            bake_echo_blue "i gh (GitHub CLI) is already installed"
        else
            bake_echo_cyan "Installing gh via Homebrew..."
            brew install gh
        fi

        # 7. Install argocd CLI (required for verification and cluster management)
        if command -v argocd &>/dev/null; then
            bake_echo_blue "i argocd CLI is already installed"
        else
            bake_echo_cyan "Installing argocd CLI via Homebrew..."
            brew install argocd
        fi

        bake_echo_green "✓ All macOS dependencies checked and installed!"
    else
        bake_echo_red "✗ This installer currently only supports macOS (Darwin)."
        return 1
    fi
}

bake_task setup-ssh "Generate a secure Ed25519 SSH key for GitHub"
function setup-ssh () {
    local key_file="$HOME/.ssh/id_ed25519"

    bake_echo_blue "=== Setting Up GitHub SSH Key ==="

    if [ -f "$key_file" ]; then
        bake_echo_yellow "i SSH key already exists at $key_file"
    else
        # Try to get git email, fallback to whoami@hostname
        local email
        email=$(git config --global user.email 2>/dev/null || echo "$(whoami)@$(hostname)")

        bake_echo_cyan "Generating Ed25519 SSH key pair with comment: $email..."
        mkdir -p "$HOME/.ssh"
        chmod 700 "$HOME/.ssh"

        # Generate the key (will prompt for passphrase if you want one)
        ssh-keygen -t ed25519 -C "$email" -f "$key_file"
    fi

    # Start ssh-agent and add key
    bake_echo_cyan "Adding key to ssh-agent..."
    eval "$(ssh-agent -s)"

    # Configure SSH config to automatically load keys and store passphrases in Keychain (macOS standard)
    local ssh_config="$HOME/.ssh/config"
    if [ ! -f "$ssh_config" ] || ! grep -q "UseKeychain" "$ssh_config"; then
        bake_echo_cyan "Configuring $ssh_config for macOS Keychain integration..."
        cat >> "$ssh_config" <<EOF

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile $key_file
EOF
        chmod 600 "$ssh_config"
    fi

    ssh-add --apple-use-keychain "$key_file"

    bake_echo_green "✓ SSH key configuration completed!"
    bake_echo_blue "=== Copy the public key below and add it to GitHub (https://github.com/settings/keys) ==="
    cat "${key_file}.pub"
    bake_echo_blue "=================================================================================="
}

bake_task deploy-traefik "Deploy Traefik Ingress with Cloudflare DNS-01 challenge"
function deploy-traefik () {
    bake_echo_blue "=== Deploying Traefik Ingress ==="

    if ! command -v helm &>/dev/null; then
        bake_echo_red "✗ Helm is not installed. Run 'bake install' first."
        return 1
    fi

    # Check for required environment variables
    if [ -z "${CF_DNS_API_TOKEN:-}" ]; then
        bake_echo_red "✗ Error: CF_DNS_API_TOKEN environment variable is not set."
        bake_echo_yellow "Please export your Cloudflare API Token (Zone.DNS.Edit permission):"
        bake_echo_yellow "  export CF_DNS_API_TOKEN=\"your-token\""
        return 1
    fi

    if [ -z "${CF_ACME_EMAIL:-}" ]; then
        bake_echo_red "✗ Error: CF_ACME_EMAIL environment variable is not set."
        bake_echo_yellow "Please export your Let's Encrypt / Cloudflare email address:"
        bake_echo_yellow "  export CF_ACME_EMAIL=\"your-email@example.com\""
        return 1
    fi

    # 1. Add repo and update
    helm repo add traefik https://traefik.github.io/charts
    helm repo update

    # 2. Create Namespace if it doesn't exist
    kubectl create namespace traefik --dry-run=client -o yaml | kubectl apply -f -

    # 3. Deploy the Cloudflare credentials secret
    bake_echo_cyan "Creating Cloudflare credentials secret..."
    kubectl create secret generic cloudflare-credentials \
      --namespace traefik \
      --from-literal=CF_DNS_API_TOKEN="$CF_DNS_API_TOKEN" \
      --from-literal=CF_ACME_EMAIL="$CF_ACME_EMAIL" \
      --dry-run=client -o yaml | kubectl apply -f -

    # 4. Deploy Traefik via Helm
    bake_echo_cyan "Deploying Traefik Helm release..."
    helm upgrade --install traefik traefik/traefik \
      --namespace traefik \
      --values "$(bake_bakefile_dir)/traefik/values.yaml"

    # 5. Apply the TLSStore configuration for the default wildcard certificate
    bake_echo_cyan "Applying default TLSStore wildcard certificate configuration..."
    kubectl apply -f "$(bake_bakefile_dir)/traefik/tls-store.yaml"

    bake_echo_green "✓ Traefik deployed and TLSStore configured successfully!"
}

bake_task deploy-argocd "Deploy ArgoCD with GitHub OAuth and Traefik Ingress"
function deploy-argocd () {
    bake_echo_blue "=== Deploying ArgoCD ==="

    if ! command -v helm &>/dev/null; then
        bake_echo_red "✗ Helm is not installed. Run 'bake install' first."
        return 1
    fi

    # 1. Add repo and update
    helm repo add argo https://argoproj.github.io/argo-helm
    helm repo update

    # 2. Create Namespace if it doesn't exist
    kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -

    # Check if the secret already exists in Kubernetes
    local secret_exists=0
    if kubectl get secret argocd-github-oauth -n argocd &>/dev/null; then
        secret_exists=1
    fi

    local deploy_secret=0
    if [ "$secret_exists" -eq 0 ]; then
        deploy_secret=1
    else
        # If it exists, check if they provided new env vars to override
        if [ -n "${ARGOCD_GITHUB_CLIENT_ID:-}" ] && [ -n "${ARGOCD_GITHUB_CLIENT_SECRET:-}" ]; then
            deploy_secret=1
        fi
    fi

    if [ "$deploy_secret" -eq 1 ]; then
        if [ -z "${ARGOCD_GITHUB_CLIENT_ID:-}" ] || [ -z "${ARGOCD_GITHUB_CLIENT_SECRET:-}" ]; then
            bake_echo_yellow "No GitHub OAuth credentials found in the environment or Kubernetes."
            bake_echo_blue "=== Creating GitHub OAuth Application ==="
            bake_echo_cyan "We will open GitHub settings in your browser."
            bake_echo_cyan "Please use the following values to register the application:"
            echo ""
            echo -e "  Application name:   ArgoCD Homelab"
            echo -e "  Homepage URL:       https://argocd.noeg.ai"
            echo -e "  Authorization callback URL: https://argocd.noeg.ai/api/dex/callback"
            echo ""
            
            # Open browser on macOS
            if [[ "$OSTYPE" == "darwin"* ]]; then
                open "https://github.com/settings/applications/new"
            fi

            echo -n "Please enter the Client ID: "
            read -r ARGOCD_GITHUB_CLIENT_ID
            echo -n "Please enter the Client Secret: "
            read -s -r ARGOCD_GITHUB_CLIENT_SECRET
            echo ""

            if [ -z "$ARGOCD_GITHUB_CLIENT_ID" ] || [ -z "$ARGOCD_GITHUB_CLIENT_SECRET" ]; then
                bake_echo_red "✗ Error: Client ID and Client Secret cannot be empty."
                return 1
            fi
        fi

        # Deploy the GitHub OAuth credentials secret
        bake_echo_cyan "Creating GitHub OAuth credentials secret..."
        kubectl create secret generic argocd-github-oauth \
          --namespace argocd \
          --from-literal=client-id="$ARGOCD_GITHUB_CLIENT_ID" \
          --from-literal=client-secret="$ARGOCD_GITHUB_CLIENT_SECRET" \
          --dry-run=client -o yaml | kubectl apply -f -
        kubectl label secret argocd-github-oauth app.kubernetes.io/part-of=argocd -n argocd --overwrite
    else
        bake_echo_blue "i Using existing GitHub OAuth credentials from secret 'argocd-github-oauth'"
    fi

    # 4. Deploy ArgoCD via Helm
    bake_echo_cyan "Deploying ArgoCD Helm release..."
    helm upgrade --install argocd argo/argo-cd \
      --namespace argocd \
      --values "$(bake_bakefile_dir)/argocd/values.yaml"

    # 5. Apply the Traefik IngressRoute
    bake_echo_cyan "Applying Traefik IngressRoute..."
    kubectl apply -f "$(bake_bakefile_dir)/argocd/ingress-route.yaml"

    # 6. Restart Server and Dex pods to ensure ConfigMaps are applied immediately
    bake_echo_cyan "Rolling out restart of ArgoCD pods to apply configurations..."
    kubectl rollout restart deployment argocd-server -n argocd
    kubectl rollout restart deployment argocd-dex-server -n argocd

    # 7. Verify connection using argocd CLI
    if command -v argocd &>/dev/null; then
        bake_echo_cyan "Verifying connection to argocd.noeg.ai using argocd CLI (with retries)..."
        # Wait for the rollout to complete before verifying
        kubectl rollout status deployment/argocd-server -n argocd >/dev/null 2>&1
        
        local success=0
        for i in {1..15}; do
            if argocd version --server argocd.noeg.ai --grpc-web &>/dev/null; then
                success=1
                break
            fi
            sleep 2
        done

        if [ "$success" -eq 1 ]; then
            bake_echo_green "✓ Connection verified! argocd CLI successfully connected to server."
        else
            bake_echo_yellow "⚠ Warning: CLI connection check failed. The server might still be starting, or DNS is not resolved yet."
        fi
    fi

    bake_echo_green "✓ ArgoCD deployed successfully! Access it at: https://argocd.noeg.ai"
}

bake_task deploy-grafana "Deploy Grafana via ArgoCD with GitHub OAuth and strict access control"
function deploy-grafana () {
    bake_echo_blue "=== Deploying Grafana via ArgoCD ==="

    if ! command -v helm &>/dev/null; then
        bake_echo_red "✗ Helm is not installed. Run 'bake install' first."
        return 1
    fi

    # 1. Create monitoring namespace if it doesn't exist
    kubectl create namespace monitoring --dry-run=client -o yaml | kubectl apply -f -

    # 2. Check if Grafana GitHub credentials secret exists
    local secret_exists=0
    if kubectl get secret grafana-github-oauth -n monitoring &>/dev/null; then
        secret_exists=1
    fi

    local deploy_secret=0
    if [ "$secret_exists" -eq 0 ]; then
        deploy_secret=1
    else
        # If it exists, check if new env vars are provided to override
        if [ -n "${GRAFANA_GITHUB_CLIENT_ID:-}" ] && [ -n "${GRAFANA_GITHUB_CLIENT_SECRET:-}" ]; then
            deploy_secret=1
        fi
    fi

    if [ "$deploy_secret" -eq 1 ]; then
        if [ -z "${GRAFANA_GITHUB_CLIENT_ID:-}" ] || [ -z "${GRAFANA_GITHUB_CLIENT_SECRET:-}" ]; then
            bake_echo_yellow "No Grafana GitHub OAuth credentials found in the environment or Kubernetes."
            bake_echo_blue "=== Creating GitHub OAuth Application for Grafana ==="
            bake_echo_cyan "We will open GitHub settings in your browser."
            bake_echo_cyan "Please use the following values to register the application:"
            echo ""
            echo -e "  Application name:           Grafana Homelab"
            echo -e "  Homepage URL:               https://grafana.noeg.ai"
            echo -e "  Authorization callback URL: https://grafana.noeg.ai/login/github"
            echo ""
            
            # Open browser on macOS
            if [[ "$OSTYPE" == "darwin"* ]]; then
                open "https://github.com/settings/applications/new"
            fi

            echo -n "Please enter the Client ID: "
            read -r GRAFANA_GITHUB_CLIENT_ID
            echo -n "Please enter the Client Secret: "
            read -s -r GRAFANA_GITHUB_CLIENT_SECRET
            echo ""

            if [ -z "$GRAFANA_GITHUB_CLIENT_ID" ] || [ -z "$GRAFANA_GITHUB_CLIENT_SECRET" ]; then
                bake_echo_red "✗ Error: Client ID and Client Secret cannot be empty."
                return 1
            fi
        fi

        # Deploy the GitHub OAuth credentials secret
        bake_echo_cyan "Creating Grafana GitHub OAuth credentials secret..."
        kubectl create secret generic grafana-github-oauth \
          --namespace monitoring \
          --from-literal=GF_AUTH_GITHUB_CLIENT_ID="$GRAFANA_GITHUB_CLIENT_ID" \
          --from-literal=GF_AUTH_GITHUB_CLIENT_SECRET="$GRAFANA_GITHUB_CLIENT_SECRET" \
          --dry-run=client -o yaml | kubectl apply -f -
        kubectl label secret grafana-github-oauth app.kubernetes.io/part-of=grafana -n monitoring --overwrite
    else
        bake_echo_blue "i Using existing GitHub OAuth credentials from secret 'grafana-github-oauth'"
    fi

    # 3. Apply the ArgoCD Application manifest for Grafana
    bake_echo_cyan "Applying Grafana ArgoCD Application..."
    kubectl apply -f "$(bake_bakefile_dir)/argocd/apps/grafana.yaml"

    bake_echo_green "✓ Grafana deployment initiated successfully via ArgoCD!"
    bake_echo_yellow "⚠️  IMPORTANT: To test your changes before merging to main, use the ArgoCD CLI revision override:"
    echo "  1. Push your local files to your feature branch (e.g. feat/grafana-deploy)"
    echo "  2. Run the override command:   argocd app set grafana --revision feat/grafana-deploy"
    echo "  3. When verified and merged, reset:  argocd app set grafana --revision main"
    echo ""
    bake_echo_blue "Access your Grafana dashboard at: https://grafana.noeg.ai"
    bake_echo_yellow "Note: Strict access control is enabled. Only user 'nagonzalez' will be allowed to log in."
}

